# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database -------------------------------------------------------------
# Inside docker compose the host is the service name "db".
DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
DB_ECHO=false

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Shared sign-in password; the username becomes the learner's identity.
AUTH_PASSWORD=change-me

# --- LLM ------------------------------------------------------------------
# huggingface -> Meta-Llama-3-8B-Instruct via the HF Inference API (the v1 model)
# openai      -> any OpenAI-compatible /chat/completions endpoint
# stub        -> deterministic offline client, no network and no API key needed
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5

# --- Tutor behaviour ------------------------------------------------------
# Self-check must reach this confidence for the answer to count as verified.
SELF_CHECK_MIN_CONFIDENCE=0.6
MAX_SOLVE_RETRIES=2
MAX_GRAPH_STEPS=14
# How many prior messages are replayed to the model as conversation context.
HISTORY_WINDOW=8

# --- Frontend -------------------------------------------------------------
# Used by the Streamlit app to reach the API (service name inside compose).
API_BASE_URL=http://localhost:8000

# --- Agent mode (Claude Agent SDK) ----------------------------------------
# claude_sdk -> the real Claude engine. It signs in the way the `claude` CLI
#               on this machine does: your Claude subscription (personal use,
#               billed to your monthly Agent SDK credit), or ANTHROPIC_API_KEY
#               if that variable is set (billed to the API key).
# fake       -> offline scripted agent, no network or sign-in needed
AGENT_BACKEND=claude_sdk
AGENT_NAME=Lelouch
AGENT_MODEL=claude-opus-5-5
AGENT_MODELS=["claude-opus-5-5","claude-fable-5-2","claude-sonnet-5-5"]
# low | medium | high | xhigh | max - how hard the model thinks
AGENT_EFFORT=high
# adaptive (the model decides how long to think) | disabled
AGENT_THINKING=adaptive
AGENT_MAX_TURNS=40
# Hard spend cap per turn (USD at API list prices), to protect your credit
AGENT_MAX_BUDGET_USD=3.0
AGENT_TIMEOUT_SECONDS=900
AGENT_WORKSPACE_DIR=./workspace
AGENT_ENABLE_WEB=true
# Playwright browser via MCP (needs Node.js 18+; downloaded by npx on first use)
AGENT_ENABLE_PLAYWRIGHT=true
AGENT_PLAYWRIGHT_COMMAND="npx -y @playwright/mcp@latest --headless --isolated"
# Your own MCP servers; copy mcp_servers.example.json to mcp_servers.json
AGENT_MCP_CONFIG_PATH=mcp_servers.json
# Leave unset to use the engine bundled with claude-agent-sdk
# AGENT_CLI_PATH=/usr/local/bin/claude
# For the public version later: set this and usage bills to the API key instead
# ANTHROPIC_API_KEY=sk-ant-...

# --- Knowledge base (RAG over your uploads) -------------------------------
# fastembed -> local ONNX embeddings (~130 MB model downloaded on first use)
# hashing   -> crude keyword hashing, no download (tests / offline only)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
MAX_UPLOAD_MB=20
