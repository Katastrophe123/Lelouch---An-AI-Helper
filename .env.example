# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database -------------------------------------------------------------
# Inside docker compose the host is the service name "db".
DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
DB_ECHO=false

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Shared sign-in password; the username becomes the learner's identity.
AUTH_PASSWORD=change-me

# --- LLM ------------------------------------------------------------------
# huggingface -> Meta-Llama-3-8B-Instruct via the HF Inference API (the v1 model)
# openai      -> any OpenAI-compatible /chat/completions endpoint
# stub        -> deterministic offline client, no network and no API key needed
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5

# --- Tutor behaviour ------------------------------------------------------
# Self-check must reach this confidence for the answer to count as verified.
SELF_CHECK_MIN_CONFIDENCE=0.6
MAX_SOLVE_RETRIES=2
MAX_GRAPH_STEPS=14
# How many prior messages are replayed to the model as conversation context.
HISTORY_WINDOW=8

# --- Frontend -------------------------------------------------------------
# Used by the Streamlit app to reach the API (service name inside compose).
API_BASE_URL=http://localhost:8000
